    "class PyAnnoteDiarizer:\n",
    "    \"\"\"Диаризация на основе pyannote/speaker-diarization-community-1.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, device: torch.device, hf_token: str = \"\"):\n",
    "        self.hf_token = hf_token or os.environ.get(\"HF_TOKEN\", \"\")\n",
    "        self.device = device if isinstance(device, torch.device) else torch.device(device)\n",
    "\n",
    "        self.pipeline = Pipeline.from_pretrained(\n",
    "            \"pyannote/speaker-diarization-community-1\",\n",
    "            token=self.hf_token or None,\n",
    "        )\n",
    "        self.pipeline.to(self.device)\n",
    "\n",
    "    def process(\n",
    "        self, wav: np.ndarray, sr: int\n",
    "    ) -> tuple[dict[str, list[tuple[float, float]]], list[tuple[float, float]]]:\n",
    "        \"\"\"Возвращает (speaker_segments, overlap) для всего трека.\n",
    "        \"\"\"\n",
    "        waveform = torch.from_numpy(wav).unsqueeze(0)\n",
    "        result = self.pipeline({\"waveform\": waveform, \"sample_rate\": sr})\n",
    "\n",
    "        speaker_segments = defaultdict(list)\n",
    "        for segment, _, speaker in result.exclusive_speaker_diarization.itertracks(yield_label=True):\n",
    "            speaker_segments[speaker].append((segment.start, segment.end))\n",
    "\n",
    "        overlap = _normalize(\n",
    "            [(seg.start, seg.end) for seg in result.speaker_diarization.get_overlap()]\n",
    "        )\n",
    "\n",
    "        return dict(speaker_segments), overlap\n"
   ]
  },
