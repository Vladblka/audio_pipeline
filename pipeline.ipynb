    "def _normalize(intervals, eps=1e-6):\n",
    "    \"\"\"Сортирует и схлопывает перекрывающиеся/касающиеся интервалы.\"\"\"\n",
    "    out = []\n",
    "    for s, e in sorted(intervals):\n",
    "        if e - s <= eps:\n",
    "            continue\n",
    "        if out and s <= out[-1][1] + eps:\n",
    "            out[-1][1] = max(out[-1][1], e)\n",
    "        else:\n",
    "            out.append([s, e])\n",
    "    return [(s, e) for s, e in out]\n",
    "\n",
    "\n",
    "def _subtract(base, holes):\n",
    "    \"\"\"base минус holes.\"\"\"\n",
    "    out = []\n",
    "    for s, e in base:\n",
    "        cur = [(s, e)]\n",
    "        for hs, he in holes:\n",
    "            nxt = []\n",
    "            for cs, ce in cur:\n",
    "                if he <= cs or hs >= ce:\n",
    "                    nxt.append((cs, ce))\n",
    "                    continue\n",
    "                if cs < hs:\n",
    "                    nxt.append((cs, hs))\n",
    "                if he < ce:\n",
    "                    nxt.append((he, ce))\n",
    "            cur = nxt\n",
    "        out.extend(cur)\n",
    "    return out\n",
    "\n",
    "\n",
    "def _intersect(a, b):\n",
    "    \"\"\"Пересечение двух наборов интервалов (например: спикер x VAD-речь).\n",
    "    Используется, чтобы оставить внутри диаризационного сегмента только те\n",
    "    участки, где Silero VAD реально видит речь - обрезает тишину по краям и\n",
    "    выкидывает куски без речи внутри.\n",
    "    \"\"\"\n",
    "    a = _normalize(a)\n",
    "    b = _normalize(b)\n",
    "    out = []\n",
    "    i = j = 0\n",
    "    while i < len(a) and j < len(b):\n",
    "        s = max(a[i][0], b[j][0])\n",
    "        e = min(a[i][1], b[j][1])\n",
    "        if e - s > 1e-6:\n",
    "            out.append((s, e))\n",
    "        if a[i][1] < b[j][1]:\n",
    "            i += 1\n",
    "        else:\n",
    "            j += 1\n",
    "    return out\n",
    "\n",
    "\n",
    "def _min_cut(wav, s, e, sr=16000):\n",
    "    \"\"\"Точка разреза в минимуме голосовой активности (min-cut, как в WhisperX).\"\"\"\n",
    "    lo, hi = s + (e - s) / 3, e - (e - s) / 3\n",
    "    frame = int(0.05 * sr)\n",
    "    chunk = wav[int(lo * sr):int(hi * sr)]\n",
    "    n = len(chunk) // frame\n",
    "    if n < 2:\n",
    "        return (s + e) / 2\n",
    "    rms = [float(np.sqrt(np.mean(chunk[k * frame:(k + 1) * frame] ** 2))) for k in range(n)]\n",
    "    k = min(range(n), key=lambda i: rms[i])\n",
    "    return lo + (k + 0.5) * 0.05\n",
    "\n",
    "\n",
    "def _split_long(wav, s, e, spk, max_dur, sr=16000):\n",
    "    \"\"\"Рекурсивно режет кусок длиннее max_dur - иначе он молча пропадёт.\"\"\"\n",
    "    if e - s <= max_dur:\n",
    "        return [(s, e, spk)]\n",
    "    cut = _min_cut(wav, s, e, sr)\n",
    "    return _split_long(wav, s, cut, spk, max_dur, sr) + _split_long(wav, cut, e, spk, max_dur, sr)\n"
   ]
  },
